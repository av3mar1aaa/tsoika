ADMIN_USERNAME=admin
# Важно: каждый $ в bcrypt-хеше нужно экранировать как \$
# (в systemd EnvironmentFile на сервере — наоборот, без экранирования)
ADMIN_PASSWORD_HASH=\$2b\$12\$paste_rest_of_hash_here
SESSION_SECRET=paste_long_random_hex_here

# Публичный адрес сайта: sitemap, robots, OG-теги.
# Читается в рантайме — после смены домена достаточно перезапуска.
SITE_URL=http://localhost:3000

# Yandex Object Storage
# YC_BUCKET — публичный бакет с фото и видео.
# BACKUP_BUCKET — ОТДЕЛЬНЫЙ приватный бакет под дампы базы.
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=
YC_BUCKET=
BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=14

# База. Пусто = локальный SQLite-файл (см. DATABASE_PATH).
# Turso больше не используется, переменные оставлены для миграции
# старых данных скриптом `npm run dump-turso`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Путь к локальному SQLite-файлу. По умолчанию data/app.db.
# На сервере — вне каталога с кодом: /var/lib/tsoika/app.db
DATABASE_PATH=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
